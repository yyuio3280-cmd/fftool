KEY = bytes([89,103,38,116,99,37,68,69,117,104,54,37,90,99,94,56])
IV  = bytes([54,111,121,90,68,114,50,50,69,51,121,99,104,106,77,37])
OB  = "OB55"
VER = "2.132.5"

PLATFORMS = ["8","3","5","6","11","13","4"]   # ✅ إصلاح: كان "" بدل "11"
PNAMES = {"8":"Google","3":"Facebook","5":"VK","6":"Huawei","11":"X","13":"Apple","4":"Guest"}

PING = bytes([0x0A,0x00,0x08,0x00,0x10,0x00,0x18,0x00,0x20,0x00,0x28,0x00,0x30,0x00,
              0x38,0x00,0x40,0x00,0x48,0x00,0x50,0x00,0x58,0x00,0x60,0x00,0x68,0x00,
              0x70,0x00,0x78,0x00,0x80,0x01,0x00])

