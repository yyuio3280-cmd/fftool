import asyncio, aiohttp, ssl, time, os, sys, warnings, logging
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad, unpad
from urllib3.exceptions import InsecureRequestWarning

warnings.filterwarnings("ignore", category=InsecureRequestWarning)

logger = logging.getLogger(__name__)

# ============================================================
# ⚙️ PROXY CONFIGURATION — ضع بروكسيك هنا
# ============================================================
# أمثلة:
#   PROXY_URL = "socks5://IP:PORT"
#   PROXY_URL = "socks5://USER:PASS@IP:PORT"
#   PROXY_URL = "http://USER:PASS@IP:PORT"
PROXY_URL = ""              # ← اتركه فارغاً لتعطيل البروكسي
USE_PROXY = False           # ← True لتفعيل البروكسي
PROXY_TIMEOUT = 15          # مهلة الاتصال عبر البروكسي


# ============================================================
# ⚙️ SESSION CONFIG
# ============================================================
bimo_int = 0.0001           # ping interval
bimo_dley = 0.0001          # reconnect delay
